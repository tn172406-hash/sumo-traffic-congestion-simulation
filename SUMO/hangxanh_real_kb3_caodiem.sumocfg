<configuration>
    <!-- ============================================================== -->
    <!-- BẢN ĐỒ THỰC TẾ (OSM) - KỊCH BẢN 3: MỨC CAO (GIỜ CAO ĐIỂM - ÁP LỰC ÙN TẮC) -->
    <!-- ============================================================== -->
    <input>
        <net-file value="hangxanh_real.net.xml"/>
        <route-files value="hangxanh_real.rou.xml"/>
        <additional-files value="hangxanh.vtypes.xml,hangxanh_buildings.poly.xml"/>
    </input>

    <!-- Hệ số điều chỉnh: 0.8 (80% lưu lượng gốc để dòng xe ùn ứ giờ cao điểm) -->
    <scale value="0.8"/>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>

    <processing>
        <lateral-resolution value="0.8"/>
        <time-to-teleport value="40"/>
    </processing>

    <output>
        <tripinfo-output value="output_real/real_kb3_tripinfo.xml"/>
        <summary-output value="output_real/real_kb3_summary.xml"/>
    </output>

    <gui_only>
        <gui-settings-file value="hangxanh.view.xml"/>
        <start value="true"/>
    </gui_only>
</configuration>
