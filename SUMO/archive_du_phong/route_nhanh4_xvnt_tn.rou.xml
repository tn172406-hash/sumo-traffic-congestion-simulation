<routes>
    <!-- ========================================================================= -->
    <!-- THÀNH VIÊN 4: NHÁNH XÔ VIẾT NGHỆ TĨNH (HƯỚNG TỪ THỊ NGHÈ LÊN NÚT GIAO)     -->
    <!-- ========================================================================= -->

    <!-- Lộ trình 4.1: Đi thẳng từ Thị Nghè sang Bến xe Miền Đông -->
    <route id="R_TN_Straight_to_BX" edges="E_XVNT_TN_in E_XVNT_BX_out"/>

    <!-- Lộ trình 4.2: Rẽ phải từ Thị Nghè vào Điện Biên Phủ (hướng Quận 1) -->
    <route id="R_TN_Turn_Right_Q1"   edges="E_XVNT_TN_in E_DBP_GND_Q1_out E_DBP_Q1_out"/>

    <!-- Lộ trình 4.3: Rẽ trái từ Thị Nghè vào Điện Biên Phủ (hướng Cầu Sài Gòn) -->
    <route id="R_TN_Turn_Left_CSG"   edges="E_XVNT_TN_in E_DBP_GND_CSG_out E_DBP_CSG_out"/>


    <!-- ====================== KHAI BÁO DÒNG XE (FLOWS) ====================== -->
    <!-- Đi thẳng sang Bến xe -->
    <flow id="F_TV4_Straight_Moto" type="motorcycle" route="R_TN_Straight_to_BX" begin="0" end="3600" number="1200" departLane="best"/>
    <flow id="F_TV4_Straight_Car"  type="passenger"  route="R_TN_Straight_to_BX" begin="0" end="3600" number="250"  departLane="best"/>
    <flow id="F_TV4_Straight_Bus"  type="bus"        route="R_TN_Straight_to_BX" begin="0" end="3600" number="40"   departLane="best"/>

    <!-- Rẽ phải vào Quận 1 -->
    <flow id="F_TV4_Right_Moto"    type="motorcycle" route="R_TN_Turn_Right_Q1"   begin="0" end="3600" number="700"  departLane="best"/>
    <flow id="F_TV4_Right_Car"     type="passenger"  route="R_TN_Turn_Right_Q1"   begin="0" end="3600" number="200"  departLane="best"/>

    <!-- Rẽ trái ra Cầu Sài Gòn -->
    <flow id="F_TV4_Left_Moto"     type="motorcycle" route="R_TN_Turn_Left_CSG"   begin="0" end="3600" number="500"  departLane="best"/>
    <flow id="F_TV4_Left_Car"      type="passenger"  route="R_TN_Turn_Left_CSG"   begin="0" end="3600" number="120"  departLane="best"/>
</routes>
