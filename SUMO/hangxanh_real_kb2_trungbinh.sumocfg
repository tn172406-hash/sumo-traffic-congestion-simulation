<configuration>
    <!-- ============================================================== -->
    <!-- BẢN ĐỒ THỰC TẾ (OSM) - KỊCH BẢN 2: LƯU LƯỢNG CAO DÀY ĐẶC NHƯNG DI CHUYỂN LIÊN TỤC -->
    <!-- ============================================================== -->
    <input>
        <net-file value="hangxanh_real.net.xml"/>
        <route-files value="hangxanh_real.rou.xml"/>
        <additional-files value="hangxanh.vtypes.xml,hangxanh_buildings.poly.xml"/>
    </input>

    <!-- Hệ số 0.85: Tăng mật độ xe cực kỳ đông đúc (gần 6.000 xe/h) -->
    <scale value="0.85"/>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>

    <processing>
        <!-- Khả năng lách làn xe máy -->
        <lateral-resolution value="0.8"/>
        <!-- Chuyển làn tức thì, linh hoạt -->
        <lanechange.duration value="0"/>
        <!-- Cho phép vượt phải như thực tế Việt Nam -->
        <lanechange.overtake-right value="true"/>
        <!-- Giải tỏa ngay sau 8 giây nếu gặp nút thắt bản đồ OSM để dòng xe luôn chuyển động -->
        <time-to-teleport value="8"/>
    </processing>

    <output>
        <tripinfo-output value="output_real/real_kb2_tripinfo.xml"/>
        <summary-output value="output_real/real_kb2_summary.xml"/>
    </output>

    <gui_only>
        <gui-settings-file value="hangxanh.view.xml"/>
        <start value="true"/>
    </gui_only>
</configuration>
