<configuration>
    <!-- ============================================================== -->
    <!-- BẢN ĐỒ THỰC TẾ (OSM) - KỊCH BẢN 2: MỨC TRUNG BÌNH (NHIỀU XE, LƯU THÔNG MƯỢT MÀ) -->
    <!-- ============================================================== -->
    <input>
        <net-file value="hangxanh_real.net.xml"/>
        <route-files value="hangxanh_real.rou.xml"/>
        <additional-files value="hangxanh.vtypes.xml,hangxanh_buildings.poly.xml"/>
    </input>

    <!-- Hệ số 0.5: Tăng mật độ xe nhiều hơn, tấp nập hơn nhưng không bị kẹt cứng -->
    <scale value="0.5"/>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>

    <processing>
        <!-- Mô hình lách làn xe máy linh hoạt -->
        <lateral-resolution value="0.8"/>
        <!-- Cho phép xe chuyển làn tức thì, không bị khựng lại chờ đợi -->
        <lanechange.duration value="0"/>
        <!-- Cho phép xe máy vượt phải tự nhiên chuẩn giao thông Việt Nam -->
        <lanechange.overtake-right value="true"/>
        <!-- Giải tỏa ngay sau 10 giây nếu gặp điểm thắt cổ chai của bản đồ OSM -->
        <time-to-teleport value="10"/>
    </processing>

    <output>
        <tripinfo-output value="output_real/real_kb2_tripinfo.xml"/>
        <summary-output value="output_real/real_kb2_summary.xml"/>
    </output>

    <gui_only>
        <gui-settings-file value="hangxanh.view.xml"/>
        <start value="true"/>
    </gui_only>
</configuration>
