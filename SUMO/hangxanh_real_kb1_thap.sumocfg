<configuration>
    <!-- ============================================================== -->
    <!-- BẢN ĐỒ THỰC TẾ (OSM) - KỊCH BẢN 1: MỨC THẤP (GIỜ THẤP ĐIỂM - ĐƯỜNG THÔNG THOÁNG) -->
    <!-- ============================================================== -->
    <input>
        <net-file value="hangxanh_real.net.xml"/>
        <route-files value="hangxanh_real.rou.xml"/>
        <additional-files value="hangxanh.vtypes.xml,hangxanh_buildings.poly.xml"/>
    </input>

    <!-- Hệ số điều chỉnh: 0.2 (20% lưu lượng gốc để phản ánh đúng giờ thấp điểm vắng xe) -->
    <scale value="0.2"/>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>

    <processing>
        <lateral-resolution value="0.8"/>
        <!-- Giải tỏa xe bị khựng do lỗi làn OSM sau 30s để tránh ùn ứ giả tạo -->
        <time-to-teleport value="30"/>
    </processing>

    <output>
        <tripinfo-output value="output_real/real_kb1_tripinfo.xml"/>
        <summary-output value="output_real/real_kb1_summary.xml"/>
    </output>

    <gui_only>
        <gui-settings-file value="hangxanh.view.xml"/>
        <start value="true"/>
    </gui_only>
</configuration>
