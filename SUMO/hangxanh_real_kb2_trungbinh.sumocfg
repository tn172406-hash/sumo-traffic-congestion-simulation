<configuration>
    <!-- ============================================================== -->
    <!-- BẢN ĐỒ THỰC TẾ (OSM) - KỊCH BẢN 2: MỨC TRUNG BÌNH (LƯU LƯỢNG VỪA PHẢI, THÔNG SUỐT) -->
    <!-- ============================================================== -->
    <input>
        <net-file value="hangxanh_real.net.xml"/>
        <route-files value="hangxanh_real.rou.xml"/>
        <additional-files value="hangxanh.vtypes.xml,hangxanh_buildings.poly.xml"/>
    </input>

    <!-- Hệ số điều chỉnh: 0.35 (35% lưu lượng gốc để dòng xe chạy trật tự, không bị dồn ứ vô lý) -->
    <scale value="0.35"/>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>

    <processing>
        <lateral-resolution value="0.8"/>
        <!-- Giải tỏa ngay sau 15 giây nếu có xe bị khựng ở làn rẽ cụt OSM -->
        <time-to-teleport value="15"/>
    </processing>

    <output>
        <tripinfo-output value="output_real/real_kb2_tripinfo.xml"/>
        <summary-output value="output_real/real_kb2_summary.xml"/>
    </output>

    <gui_only>
        <gui-settings-file value="hangxanh.view.xml"/>
        <start value="true"/>
    </gui_only>
</configuration>
